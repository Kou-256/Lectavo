# Optional code signing settings for scripts/sign_release.ps1
# Do not commit real certificate paths or passwords.
# Use this for a certificate in the Windows certificate store or hardware token.
LECTAVO_CERT_SHA1=
# Use these instead when the certificate is provided as a PFX file.
LECTAVO_CERT_PATH=
LECTAVO_CERT_PASSWORD=
LECTAVO_TIMESTAMP_URL=http://timestamp.digicert.com
